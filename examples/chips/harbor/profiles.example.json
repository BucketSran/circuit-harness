      ]
    },
    "glm": {
      "connections": [
        {"protocol": "anthropic-messages", "model": "glm-fixture",
         "base_url": "https://glm-gateway.example.invalid/anthropic", "key_env": "GLM_GATEWAY_KEY"},
        {"protocol": "openai-chat-completions", "model": "glm-fixture",
         "base_url": "https://glm-gateway.example.invalid/v1", "key_env": "GLM_GATEWAY_KEY"},
        {"protocol": "openai-responses", "model": "glm-fixture",
         "base_url": "https://glm-gateway.example.invalid/v1", "key_env": "GLM_GATEWAY_KEY"}
      ]
    },
    "deepseek": {
      "connections": [
        {"protocol": "openai-chat-completions", "model": "deepseek-fixture",
         "base_url": "https://deepseek-gateway.example.invalid/v1", "key_env": "DEEPSEEK_GATEWAY_KEY"}
      ]
    },
    "gpt": {
      "connections": [
        {"protocol": "openai-responses", "model": "gpt-fixture",
         "base_url": "https://gpt-gateway.example.invalid/v1", "key_env": "GPT_GATEWAY_KEY"}
      ]
    }
  }
}
