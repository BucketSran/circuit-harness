{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "One durable occurrence of content-addressed artifact data.",
      "properties": {
        "contamination_flags": {
          "items": {
            "type": "string"
          },
          "title": "Contamination Flags",
          "type": "array"
        },
        "created_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created By"
        },
        "hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hash"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvenanceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CostProgressRecord": {
      "additionalProperties": false,
      "description": "Per-step resource delta or accumulated total.",
      "properties": {
        "artifacts_produced": {
          "default": 0,
          "minimum": 0,
          "title": "Artifacts Produced",
          "type": "integer"
        },
        "branch_progress_score": {
          "default": 0.0,
          "title": "Branch Progress Score",
          "type": "number"
        },
        "budget_consumed_fraction": {
          "default": 0.0,
          "title": "Budget Consumed Fraction",
          "type": "number"
        },
        "cache_hits": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Hits",
          "type": "integer"
        },
        "cpu_s": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cpu S",
          "type": "number"
        },
        "gpu_s": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Gpu S",
          "type": "number"
        },
        "reasoning_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Reasoning Tokens",
          "type": "integer"
        },
        "sandbox_time_s": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Sandbox Time S",
          "type": "number"
        },
        "tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "trust_level_improvement": {
          "default": 0,
          "title": "Trust Level Improvement",
          "type": "integer"
        },
        "verifier_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Verifier Calls",
          "type": "integer"
        },
        "wall_clock_s": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Wall Clock S",
          "type": "number"
        }
      },
      "title": "CostProgressRecord",
      "type": "object"
    },
    "ProvenanceRef": {
      "additionalProperties": false,
      "properties": {
        "hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hash"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "id"
      ],
      "title": "ProvenanceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Canonical audit record for one attempted tool execution.",
  "properties": {
    "args": {
      "additionalProperties": true,
      "title": "Args",
      "type": "object"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "cost": {
      "$ref": "#/$defs/CostProgressRecord"
    },
    "exit_code": {
      "default": 0,
      "title": "Exit Code",
      "type": "integer"
    },
    "fs_diff": {
      "additionalProperties": true,
      "title": "Fs Diff",
      "type": "object"
    },
    "sandbox": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sandbox"
    },
    "stderr": {
      "default": "",
      "title": "Stderr",
      "type": "string"
    },
    "stdout": {
      "default": "",
      "title": "Stdout",
      "type": "string"
    },
    "tool_id": {
      "title": "Tool Id",
      "type": "string"
    }
  },
  "required": [
    "tool_id"
  ],
  "title": "ToolCallRecord",
  "type": "object"
}
