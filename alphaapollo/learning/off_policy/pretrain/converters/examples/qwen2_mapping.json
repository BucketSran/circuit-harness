{
  "_doc": "Example mapping: Megatron GPT (Qwen2/Llama-style decoder) -> HuggingFace. Edit the split_sizes / keys for YOUR arch. {i} = layer index. split_sizes here: q_dim=128, kv_dim=32 (head_dim=32, 1 kv group); ffn=512. Matches the runbook smoke (2 layers, hidden 128, 4 heads, 1 kv group, ffn 512).",
  "num_layers": 2,
  "rules": [
    {"from": "embedding.word_embeddings.weight",            "to": "model.embed_tokens.weight"},
    {"from": "decoder.final_layernorm.weight",              "to": "model.norm.weight"},

    {"from": "decoder.layers.self_attention.linear_qkv.weight",
     "to": ["model.layers.{i}.self_attn.q_proj.weight",
            "model.layers.{i}.self_attn.k_proj.weight",
            "model.layers.{i}.self_attn.v_proj.weight"],
     "layers": true, "split_dim": 0, "split_sizes": [128, 32, 32]},

    {"from": "decoder.layers.self_attention.linear_qkv.bias",
     "to": ["model.layers.{i}.self_attn.q_proj.bias",
            "model.layers.{i}.self_attn.k_proj.bias",
            "model.layers.{i}.self_attn.v_proj.bias"],
     "layers": true, "split_dim": 0, "split_sizes": [128, 32, 32], "optional": true},

    {"_note": "mcore/TE also has linear_proj.bias (o) + mlp fc1/fc2 bias, but HF Qwen2 has mlp_bias=False and no o_proj.bias -> intentionally NOT mapped (the converter will warn they are unmapped; that is correct). For an HF target that DOES have o/mlp bias (e.g. Llama with attention_bias), add rules mapping them, or use fill_zeros."},

    {"from": "decoder.layers.self_attention.linear_qkv.layer_norm_weight",
     "to": "model.layers.{i}.input_layernorm.weight", "layers": true},

    {"from": "decoder.layers.self_attention.linear_proj.weight",
     "to": "model.layers.{i}.self_attn.o_proj.weight", "layers": true},

    {"from": "decoder.layers.mlp.linear_fc1.weight",
     "to": ["model.layers.{i}.mlp.gate_proj.weight",
            "model.layers.{i}.mlp.up_proj.weight"],
     "layers": true, "split_dim": 0, "split_sizes": [512, 512]},

    {"from": "decoder.layers.mlp.linear_fc1.layer_norm_weight",
     "to": "model.layers.{i}.post_attention_layernorm.weight", "layers": true},

    {"from": "decoder.layers.mlp.linear_fc2.weight",
     "to": "model.layers.{i}.mlp.down_proj.weight", "layers": true}
  ]
}
